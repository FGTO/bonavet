# Copy to .env.local and fill in. Leave DATABASE_URL empty to run on demo data.
# Full walkthrough: README.md › "Set up the services".

# Neon › your project › Connect › connection string (pooled), e.g.
# postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Random 32+ character secret. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The address the app is reached at (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# Google Cloud Console › APIs & Services › Credentials › OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Protects /api/cron/sync-calendars. Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional: set to 1 to force demo data even when DATABASE_URL is set.
# BONAVET_DEMO=1

# Optional: smart-home provider. Only "demo" exists today.
# DEVICE_PROVIDER=demo
